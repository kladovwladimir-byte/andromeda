FUN Select_gif_frame(
{Form} Main_f|orm, 
INT N|umber_frames|_total, 
INT Last|_frame_selected) ==> INT
    :
    {Select_gif_frame} temp_d|ialog 
    temp_d = {Select_gif_frame}(Screen_=Main_f.Screen_, total_frames = N) 
    temp_d.Set_caption("Total frames: " N.S)
	temp_d.Frame.Set_text(Last.Min(N-1).S)
	NONE = temp_d.Show_modal(Main_f)
	RESULT = temp_d.Frame.Text.Int .
    
{Paint_turtle} Inc_dec|_frame
{Button} Button_ok

METHOD before_CONSTRUCT: .

