METHOD after_CONSTRUCT: .

INT total_frames

OVERRIDE click :
    CASE sender_alias ?
    ["BUTTON_OK"]: ready("OK") 
    ["INC_DEC"]:
        CASE Inc_dec.Current ? 
        ["Dec"]: Frame.Set_text((Frame.Text.Int - 1).Max(0).S)
        ["Inc"]: Frame.Set_text((Frame.Text.Int + 1).Min(total_frames-1).S)
        ;
