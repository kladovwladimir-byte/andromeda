	...Set_width(10)
	---------------------- 'ADD_COMMAND'
	Add_command = New_paint_turtle_button(THIS,
 "ADD_COMMAND",
 "20L30RRD60B30LL30B6"
  "0")


	...Set_width(20)

	...Set_height(20)
	----------------------- 'PAINTBOX_2'
	Paintbox_2 = New_paintbox(THIS, "PAINTBOX_2", "")

	...Set_width(10)
