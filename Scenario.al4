	Set_column_height(20)
	--------------------------- 'SEARCH'
	Search = New_edit(THIS, "SEARCH")

	...Set_width(100)
	---------------------- 'SEARCH_NEXT'
	Search_next = New_paint_turtle_button(THIS,
 "SEARCH_NEXT",
 "20R60BRD 30LL 8(R15"
  ")8")


	...Set_width(20)

	...Set_height(20)
	---------------------- 'SEARCH_BACK'
	Search_back = New_paint_turtle_button(THIS,
 "SEARCH_BACK",
 "R100BR 20R60BRD 30L"
  "L 8(R15)8")


	...Set_width(20)

	...Set_height(20)
	------------------ 'INFO_FRAME_SIZE'
	Info_frame_size = {Label}(Form_=THIS, Alias="INFO_FRAME_SIZE")

	...Set_text("640x360")
	------------------ 'INFO_FRAME_RATE'
	Info_frame_rate = {Label}(Form_=THIS, Alias="INFO_FRAME_RATE")

	...Set_text("25 fr/sec")
	---------------------------- 'TEMPO'
	Tempo = New_combo(THIS, "TEMPO", @
"1:1 Normal speed"
":1.25 times slower"
":1.5 times slower"
":2 times slower"
"x1.5 times faster"
"x2 times faster"
"x5 times faster"
"x10 times faster")
	...Set_anchor_bottom(TRUE)
	----------------------- 'INFO_TOTAL'
	Info_total = {Label}(Form_=THIS, Alias="INFO_TOTAL")

	...Set_width(90)

	...Set_text("Total: 0 sec")
	------------------------------------------------------------- 'column COL_1'
	new_column("COL_1", 'CENTER', DEFAULT_SIZES)

	-------------------- 'MEMO_COMMANDS'
	Memo_commands = New_memo(THIS,
 "MEMO_COMMANDS",
 MEMO_NO_HSCROLL),
 >> grayable[]
