	Record = New_paint_turtle_button(THIS, "RECORD", "30L30DF (5 10C)40")

	...Set_width(20)

	...Set_height(20)
	----------------------- 'ADDITIONAL'
	Additional = New_paint_turtle_button(THIS,
 "ADDITIONAL",
 "20R40LL (D5LL5LL5LL5L"
  "LU25)3")


	...Set_width(20)

	...Set_height(20)
	--------------------- 'HINT_COMMAND'
	Hint_command = New_paintbox(THIS, "HINT_COMMAND", "")
