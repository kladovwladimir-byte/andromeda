/*

CLASS {Scenario|_control}, UNTESTED, INFINITE:

IMPORT {Form_common}, {Main_plasma_tides}, {Collection_gal}, {Satellite_param} .
IMPORT: {Jpeg}, {Png} .
IMPORT: {{Visual}}, {{Standard}}, {{Files}} .


BASE CLASS: {Form_common} .
