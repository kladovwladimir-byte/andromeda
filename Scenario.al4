METHOD tempo|_speed ==> REAL :
    STR s|tring_tempo = Tempo.Text 
    CASE ? 
    [Recording] ? RESULT = 1
    [s.[0] == ":"] ? RESULT = s.[1 TO *].Real 
    [s.[0] == "x"] ? RESULT = 1 / s.[1 TO *].Real
    ELSE RESULT = 1 ; .
    
STR f_filters[]
INT i_flash|_interval = 1000
	

OVERRIDE mouse_up :
    CASE sender_alias ?
    ["MEMO_COMMANDS"]:
        STR s|_election = Memo_commands.Get_selection
        CASE s.Len > 0 ? Text_to_clipboard(s) ;
    ; .
    
    
METHOD Transforming|_now ==> BOOL :
    CASE Finished && !Recording ? ==> ;
    RESULT = wait_for_t.Milliseconds_diff(now) > 0 .
    
METHOD Transiting ==> BOOL :
    RESULT = Transforming
    CASE RESULT ? ==> ;
	CASE Finished && !Recording ? ==> ;
    RESULT = wait_for_o.Milliseconds_diff(now) > 0
    .. ||= wait_for_v.Milliseconds_diff(now) > 0         
    .. ||= wait_for_c.Milliseconds_diff(now) > 0         
    .. ||= wait_for_m.Milliseconds_diff(now) > 0         
    .
    
METHOD Running|_now ==> BOOL :
    = !Finished || Recording .
    
INT last_pos_count_line
INT last_counted_lines

METHOD count_line_at_pos(INT pos|ition_in_text) ==> INT :
	CASE last_pos_count_line > pos ? 
	     last_counted_lines = 0
	     last_pos_count_line = 0 ;

    RESULT = last_counted_lines 
    	+ Count_char(memo_text.[last_pos_count_line TO pos-1], #CR) 
    	
    last_counted_lines = RESULT 
    last_pos_count_line = pos .
    
METHOD line_to_range(INT line|_index) ==> {from_to} :
	
	CASE line < last_line_to_range ? 
	     last_line_to_range = 0
	     last_n = 0
	     last_i = 0 ;
    //DEBUG: "line to range: " line " lines: " Count_char(memo_text, #CR)
    //    " last_line_to_range=" last_line_to_range
    //    " last_n=" last_n
    //    " last_i=" last_i #NL ;
	INT n|umber_of_line = last_n // 0
	RESULT.To = memo_text.Len-1
    FOR i IN [last_i TO memo_text.Len-1] :
        CASE memo_text.[i]==#CR ? 
             n += 1 
        	 CASE ?
        	 [n==line ] ? RESULT.From = i+1
        	 	CASE memo_text.[RESULT.From] == #LF ? 
        	 	     RESULT.From += 1 ;
                //DEBUG: ",,,,,,,,,,,,,,,,,,,,,,,,,,found line " n " at " i #NL ;
                last_i = i
                last_n = n-1
                last_line_to_range = line
        	 [n-1==line] ? RESULT.To = i-1
        	 	CASE memo_text.[RESULT.To]==#LF ?
        	 	     RESULT.To -= 1 ;
                //DEBUG: ",,,,,,,,,,,,,,,,,,found end of line at " RESULT.To #NL ;
        	 	==>
        	 ;
        ;
    ; .
    
INT last_line_to_range
INT last_n|umber_of_line
INT last_i|ndex_in_text
	

OVERRIDE disabled ==> BOOL :
    CASE sender_alias ?
    ["MEMO_COMMANDS"]: RESULT = Recording
    ; .
    
INT Progress_color = LIME

METHOD extract_russian_subtitles :
	STR lines|_of_text[].Split(Memo_commands.Text, #NL)
	FOR t IN lines[] :
	    CASE t.Lower.[0] ?
	    ["s"]:
	         STR line|_extracted = t.After("ru=") 
	    ["r"]:
	        CASE t.Upper.Starting("R ") ? line = t.After(" ").Trim 
	        ELSE line = t.[1 TO *].Trim ;
	    ELSE CONTINUE t ;
	    CASE line == "" ? CONTINUE t ;
	    STR ru|ssian_text = _ line #NL     
	;
	CASE ru=="" ? message("No Russian text to copy!") 
	ELSE Text_to_clipboard(ru) ; .

END

