METHOD after_CONSTRUCT: 
	Show_application_button(TRUE)
	------------------------ 'bounds', REUSED
	Restore_bounds(Main_.App_name, "Collection_param", "whlt") 
	------------------------------- 
	.

OVERRIDE moved :
	LIKE after_CONSTRUCT ........ 'bounds', BUT (Restore==>Save) .

OVERRIDE resize :
	LIKE after_CONSTRUCT ........ 'bounds', BUT (Restore==>Save) .
	


OVERRIDE closing ==> {Form}.{action} :
    CASE list_changed ? 
         CASE !ask("List was changed. Continue without saving it?") ? ==> ;
    ;
	RESULT = 'DECLINE'
	Hide
	.
	
INT Last_sel|ected_item = -1
	

OVERRIDE click :
    CASE sender_alias ?
    ["UP_DOWN"]:
        PUSH Lock_select = TRUE :
        CASE Up_down.Current ? 
        ["Down"]:
            CASE Last_sel >= List.Count-1 || Last_sel < 0 ? ==> ;
            STR s1|_current_line = List.Get_item(Last_sel, 0)     
            STR s2|_next_line = List.Get_item(Last_sel+1, 0)
            List.Set_item(Last_sel, 0, s2)     
            List.Set_item(Last_sel+1, 0, s1)
            {Bitmap} c1|_cached
            {Bitmap} c2|_cached
            ---------------------------- 'move__caches', REUSED
            c1 = Cache_img[Last_sel]
            c2 = Cache_img[Last_sel+1]
            Cache_img[Last_sel] = c2
            Cache_img[Last_sel+1] = c1
            ----------------------------
            LIKE ....................... 'move__caches', BUT(_img==>_stamps)*4
            Last_sel += 1
        ["Up"]:    
        	CASE Last_sel <= 0 ? ==> ;
        	s1 = List.Get_item(Last_sel, 0)
        	s2 = List.Get_item(Last_sel-1, 0)
        	List.Set_item(Last_sel, 0, s2)
        	List.Set_item(Last_sel-1, 0, s1)
            ---------------------------- 'move__caches__up', REUSED
            c1 = Cache_img[Last_sel]
            c2 = Cache_img[Last_sel-1]
            Cache_img[Last_sel] = c2
            Cache_img[Last_sel-1] = c1
            ----------------------------
            LIKE ................ 'move__caches__up', BUT (_img==>_stamps)*4
        	Last_sel -= 1
        ;
        List.Select(Last_sel, TRUE)
        Changed_list
        ;
    ["SATELLITE_OP"]:
        popup_menu(

	""	Item(	"SAT_REPL",
				"Replicate current satellite"
		)

	""	Item(	"SAT_DEL",
				"Remove current satellite"
		)

	""	Item(	"REGULAR_ACTIVITY",
				"Activity in regular intervals"
		)

	""	Item(	"SAME_CENTER",
				"Use same center point"
		))



    ["ADD_GAL"]:
        CASE !Dialog_open_gal.Select_file ? ==> ;
        INT ii|tem_inserted = List.Insert_item(
        	Last_sel+1, Dialog_open_gal.Filename.Extract_file_name
        	#TAB Dialog_open_gal.Filename) 
        	
        {Bitmap} dummy|_none
        Cache_img[].Insert(Last_sel+1, dummy)
        Cache_stamps[].Insert(Last_sel+1, dummy)
        List.Select(ii, TRUE)
        Changed_list
    ["DUP_GAL"]:
        ii = List.Insert_item(Last_sel+1, List.Get_item(Last_sel, 0)) 
        Cache_img[].Insert(Last_sel+1, Cache_img[Last_sel])
        Cache_stamps[].Insert(Last_sel+1, Cache_stamps[Last_sel])
        List.Select(ii, TRUE)
        Changed_list
    ["DELETE_GAL"]: 
    	INT was_sel|ected = Last_sel
    	Last_sel = -1
    	CASE was_sel >= 0 ? 
    	     List.Delete_item(was_sel)
    	     -------------------- 'delete in caches too'
    	     Cache_img[].Delete(was_sel)
    	     Cache_stamps[].Delete(was_sel) 
    	     Changed_list
    	     ;
        //CASE ?
        //[List.Count > was_sel] ? List.Select(was_sel, TRUE)
        //[List.Count > 0] ? List.Select(was_sel-1, TRUE) ;  
    ["SAVE_COL"]: 
        CASE List.Count <= 0 ? message("Nothing to save yet!") ==> ;
        CASE !Dialog_save_col.Select_file ? ==> ;
        FOR i IN [0 TO List.Count-1] :
            STR col|lection_galaxies[] << List.Get_item(i, 0)
            col[*] = _.[0 TO .Find(#TAB)-1] ;
        col[].To_text_file(Dialog_save_col.Filename, 'UTF8')
        list_changed = FALSE
        Save_col.Set_ink(BLACK)
    ["OPEN_COL"]:
        ------------------ 'check__changed', REUSED
        CASE list_changed ? 
             CASE !ask("List was changed. Continue without saving it?") ? ==> ;
        ;
        ------------------
        CASE !Dialog_open_col.Select_file ? ==> ;
        Load_collection(Dialog_open_col.Filename)     
    ; .

    
METHOD Load_collection(STR Coll|ection_file) :
	LIKE click .................. 'check__changed'
    List.Clear
    -------------------- 'clear cached images'
    Cache_img[].Clear
    Cache_stamps[].Clear
    source_ = NONE
    ready_over[].Clear
    -------------------- 'load list from file selected'
    STR col|lection_text[].From_text_file(Coll, 'UTF8')
    {Bitmap} temp_bmp
    FOR s IN col[] :
        col[s.INDEX] = _ #TAB Coll.Extract_path _
        Cache_img[] << temp_bmp 
        Cache_stamps[] << temp_bmp 
    ;
    List.Set_text(col[0 TO *].Merge(#NL))
    List.Select(0, TRUE)     
    ---------------------- 'reset change flag'
    list_changed = FALSE
    Save_col.Set_ink(BLACK)
    .
    
METHOD Update_current|_item(STR Path|_to_gal_file) :
	CASE Last_sel < 0 ? ==> ;
	List.Set_item(Last_sel, 0, Path.Extract_file_name #TAB Path)     
    .
    
BOOL Lock_select|_events
BOOL changing_sel|ection    
//{Bitmap} Images_1|st_layer[]
//{Bitmap_direct} Overlays_1[]
REAL Rotation_1
REAL Scale_1|st_image_overlayed_defaulr_100
{point} Shift_1|st_galaxy_in_collection
{rect} Scaled_img_1|_size
STR Transform_1|_before_draw_spiral_over

OVERRIDE selection_change :
	CASE changing_sel || Lock_select ? ==> ;
	PUSH changing_sel = TRUE :
    CASE sender_alias ?
    ["LIST"]:
        PUSH Main_.Satellite_param.Stamp_param.Executing = 1 :
        PUSH Main_.Lock_invalidations = TRUE :
             CASE Last_sel==0 && Main_.Image.Width * .Height > 1 ?
                  //Images_1[].Allocate(Main_.All_images[].Count.Min(2))
                  //Overlays_1[].Clear
                  //Overlays_1[].Allocate(2)
                  //------------------------------ 'store images to draw over'
                  //FOR ii IN [0 TO Images_1[].Count-1] :
                  //    Images_1[ii] = Main_.All_images[ii]
                  //;
             	  --------------------- 'store offsets, scale, rotation'
             	  Scale_1 = Main_.Satellite_param.Scale_image.Text.Real
             	  Rotation_1 = Main_.Satellite_param.Rotate_image.Text.Real
             	  Scaled_img_1 = Main_.D_o.CLONE
             	  .. = _.Offset(-_.W*(Scale_1 - 100)/100/2, 
             	  				-_.H*(Scale_1 - 100)/100/2)

             	  Shift_1 = Pt(Main_.ShiftX, .ShiftY)
             	  Transform_1 = Main_.Last_transform
                  //Shift_1 = Pt(Main_.ShiftX * (Scale_1 - 100)/100,
                  //             Main_.ShiftY * (Scale_1 - 100)/100)
             ;
	         INT was_sat|_current = Main_.Satellite_param.Satellite_num.Current
	         DEBUG: "was_sat=" was_sat#NL ;
	         CASE Auto_save.Checked && Last_sel >= 0 ? 
	        	  --------------------- 'auto_save'
	              STR fname|_to_load = List.Get_item(Last_sel, 0).After(#TAB)
	              CASE Create_bak.Checked ? 
	                   Delete_file(fname.Change_ext(".gal.bak"))
	                   Copy_file(fname, fname.Change_ext(".gal.bak")) 
	              ;
	              CASE Last_sel > 0 ?
	                   REAL scS|elected_image_scale 
	                   scS = Main_.Satellite_param.Scale_image.Text.Real/100 
	                   scS = _ / (Scale_1/100)
	                   CASE scS <= 0 ? scS = 1 ;
	                   Main_.ShiftX = _ - Shift_1.X / scS
	                   Main_.ShiftY = _ - Shift_1.Y / scS
	                   Main_.Satellite_param.Scale_image.Set_text(
	                   	(scS*100).S_float(1))
	                   	
	                   DEBUG: "<<<<<<<<<<< store scS=" scS " Scale_1=" Scale_1 
	                   		" Scale_image:"
	                   		"" Main_.Satellite_param.Scale_image.Text #NL ;
	                  	 
	                   Main_.Satellite_param.Rotate_image.Set_text(
	                   	 (Main_.Satellite_param.Rotate_image
	                   	 .Text.Real - Rotation_1).S)
	              ;
	        	  Main_.Satellite_param.Save_gal(fname, TRUE, TRUE)
	        	  CASE Cache_images.Checked ? 
	        	       Cache_img[Last_sel] = Main_.All_images[0] 
	        	       Cache_stamps[Last_sel] = Main_.All_images[1] ;
	        	  ----------------------------- 'save stamp file'
	        	  CASE Main_.All_images[].Count >= 2 ? 
	        	       STR img_file = Main_.All_img_names[0]
	        	       CASE img_file.Exists ? 
		        	        STR stamp_file = img_file.Extract_path
			                .. = _ "stamp" if(Main_.Satellite_param.Last_frame > 0, 
			              	   "[" .Last_frame.S "]") "#" img_file.Extract_file_name 
			              	   
		        	        {Png}.To_file(Main_.All_images[1], stamp_file, 9) ;
	        	       ;
	         ;
	         Last_sel = List.Current
	         --------------------- 'to new gal model selected'
	         fname = List.Get_item(Last_sel, 0).After(#TAB)
	         Main_.Satellite_param.Preserve_scale_rot = Preserve_scale_rot.Checked
	         Main_.Satellite_param.Load_gal(fname, FALSE, TRUE)
	         ----------- 'gal loaded !!!!!!!!!!!!!!!!!!!!!!!!'
	         CASE Last_sel > 0 ? 
	              scS = Main_.Satellite_param.Scale_image.Text.Real/100
	              
	              CASE scS <= 0 ? scS = 1 ;
	              Main_.Satellite_param.Scale_image.Set_text(
	              	(scS*Scale_1).S_float(1))
	              	
	              DEBUG: ">>>>>>>>>>>>>>>>> scS=" scS " Scale_1=" Scale_1
	              		 " new Scale is " Main_.Satellite_param.Scale_image.Text 
	              		 #NL ;
	         	  
	              Main_.Satellite_param.Rotate_image.Set_text(
	              	(.Text.Real + Rotation_1).S)
	              	
	              Main_.ShiftX = _  + Shift_1.X / scS
	              Main_.ShiftY = _  + Shift_1.Y / scS
	         ;
	         Main_.Satellite_param.Satellite_num.Select(was_sat)
	         INT was_img|_current = Main_.Current_image
	         //--------------------- 'provide enough cache items'
	         {Bitmap} dummy|_temp
	         //FOR ii IN [Cache_img[].Count TO Last_sel] : Cache_img[] << dummy ;
	         //FOR ii IN [Cache_stamps[].Count TO Last_sel] : Cache_stamps[] << dummy ;
        	 --------------------------------------------- 'load images'
             Main_.Clear_images
	         img_file = fname.Extract_path 
	         CASE Main_.Satellite_param.Last_img_name != "" ? 
	              .. = _ Main_.Satellite_param.Last_img_name.Extract_file_name
	         ELSE .. = _ fname.Extract_file_name ;
	         CASE ?
	         [Cache_images.Checked 
	         && Cache_img[Last_sel].Width > 1
	         && Cache_stamps[Last_sel].Width > 1] ?
                  //DEBUG: "get from cache !!!!!!!!!!!!!!!!!"#NL ;
	              Main_.All_images[] << Cache_img[Last_sel]
	              Main_.All_img_names[] << Main_.Satellite_param.Last_img_name
	              Main_.All_scaled[] << dummy
	              Main_.All_img_URLs[] << Main_.Satellite_param.URL_loaded
                  //Main_.Image = Main_.All_images[0]
                  //Main_.Scaled_image = NONE
                  //Main_.Invalidate
                  //Main_.Process
             	  ---------------------- '+stamp'
	              Main_.All_images[] << Cache_stamps[Last_sel]
	              Main_.All_img_names[] << Main_.Satellite_param.Last_img_name
	              Main_.All_scaled[] << dummy
                  //Main_.Image = Main_.All_images[0]
                  Main_.Scaled_image = NONE
                  Main_.Image = Main_.All_images[was_img]
                  //Main_.Invalidate
                  //Main_.Process
	         [img_file.Exists] ?
	         	  STR u|rl_loaded = Main_.Satellite_param.URL_loaded 
                  //DEBUG: "get from file (" img_file ")!!!!!!!!!!!!!!!!!!!!"
                  //" url_load=" u #NL ;
	              Main_.Satellite_param.Load_image(img_file, FALSE)
	              CASE u != "" ? 
	                   Main_.All_img_URLs[].Allocate(2)
	                   Main_.All_img_URLs[0] = u 
	                   DEBUG: "assigned urls=[" Main_.All_img_URLs[].Merge(
	                   " && ") "]"#NL ;
	              ;
	              CASE Cache_images.Checked ? 
	                   Cache_img[Last_sel] = Main_.Image ;
	              //Main_.Satellite_param.Go_to_another_image
	              Main_.Satellite_param.Stamp_param.Executing = 1
	              Main_.Invalidate
	              Main_.Process
	              ---------------------------------------------- 'stamp'
	              stamp_file = img_file.Extract_path
	              .. = _ "stamp" if(Main_.Satellite_param.Last_frame > 0, 
	              	 "[" .Last_frame.S "]") "#" img_file.Extract_file_name 
	              CASE !stamp_file.Exists ? 
	                   stamp_file = _.Change_ext(".png") ;
	              CASE ?
	              [stamp_file.Exists] ?
	              	   DEBUG: "stamp from file (" stamp_file ")"#NL ;
	             	   PUSH Main_.Satellite_param.Last_img_name :     
	             	        Main_.Satellite_param.Load_image(stamp_file, FALSE) ;
	             	   {Bitmap} t|emp_stamp = Main_.Image
	             	   Main_.Image = New_bitmap_24(t.Width, t.Height, 
	             	   	Main_.Satellite_param.Stamp_parameters.Holder)
	             	   	
	             	   t.Draw(Main_.Image.Canvas, Pt(0,0))
	             	   ---------------------- 'refresh view'
	             	   Main_.All_images[1] = Main_.Image
	             	   Main_.Scaled_image = NONE
	             	   Main_.Satellite_param.Stamp_param.Executing = 1
	             	   Main_.Invalidate
	             	   Main_.Process
	              [Main_.Satellite_param.Commands_s[].Count > 0] ?
	                   Main_.Satellite_param.Do_commands_auto(FALSE)
	                   {Png}.To_file(Main_.Image, stamp_file, 9)
	              ;
	              CASE Cache_images.Checked ? 
	                   Cache_stamps[Last_sel] = Main_.Image ;
	              //Main_.Satellite_param.Go_to_another_image
	         ;
	         Timer_fix.Set_active(TRUE)
	         -------------------------- 'restore current position in images'
	         Main_.Satellite_param.Satellite_num.Select(was_sat)
	         Main_.Satellite_param.Stamp_param.Executing = 1
	         Main_.Current_image = was_img.Min(1)
	         Main_.All_img_names[0] = Main_.Satellite_param.Last_img_name
	         DEBUG: "Main_.Image " Main_.Image.Width "x" .Height 
	         		", All_images[].Count=" Main_.All_images[].Count 
	         		" Current=" Main_.Current_image
	         		" All_images[" Main_.Current_image "] size id "
	         		"" Main_.All_images[.Current_image].Width
	         		"x" Main_.All_images[.Current_image].Height #NL ;
	         Main_.Satellite_param.Go_to_another_image
	         Main_.Satellite_param.Update_URL
        ;
        ;
    ;
    ; .
    
{Bitmap} Cache_img|_main[]
{Bitmap} Cache_stamps[]
    

OVERRIDE menu_item :
    CASE menu_alias ?
    ["SAT_REPL"]:
        CASE Last_sel < 0 ? 
             message("There is no galaxy model selected.") ==> ;
        STR rname|_to_replicate = Main_.Satellite_param.Edit_name.Text
        CASE rname == "" ? 
             message("Only named satellite can be replicated between "
             "collected galaxy models.") ==> ;
        CASE !ask("Replicate satellite [" rname "] to all other models?"
        	 " (if such satellite already present there it will be replaced).") 
        	 ? ==> ;
        STR filename_in = List.Get_item(Last_sel, 0).After(#TAB)
        {In_file_config} in_c|onfiguration_temp
    	in_c = New_read_in_file_config(filename_in, "")
    	INT in_last|_section_index = last_section(in_c)
        FOR igal IN [0 TO List.Count-1] :
        	CASE igal == Last_sel ? CONTINUE igal ;
        	STR filename = List.Get_item(igal, 0).After(#TAB)
	        {In_file_config} c|onfiguration_temp
	    	c = New_write_in_file_config(filename, "")
	    	INT last_c_sec|tion = last_section(c)
	    	FOR isec IN [0 TO last_c_sec] :
	    	    c.Section = (isec+1).S 
	    	    CASE c.Bool("LAST") {
	    	         last_c_sec = isec
	    	         BREAK isec
	    	    }
	    	;
	    	PUSH c.No_write = TRUE :
	    		 //INT del_sec|tions_deleted_in_c = 0     
	    	     INT del_index = last_c_sec+1 
	        	 FOR isec IN [last_c_sec DOWNTO 0] :
	        	     c.Section = (isec+1).S 
	        	 	 CASE c.Str("Name")==rname ? 
	        	 	      c.Delete_subkey(c.Section)
	        	 	      //del_sec += 1
	        	 	      del_index = isec ;
	        	 ;
	    	;
	    	c.Update
        	STR c_text|_as_is[].From_text_file(filename, 'UTF8')
        	//INT ins_sec|tions_inserted_from_in_c = 0
        	FOR isec IN [0 TO in_last] <---------------------------
        		//DEBUG: BREAK isec ;
        	    in_c.Section = (isec+1).S 
        	    CASE in_c.Str("Name") != rname ? CONTINUE isec ;
        	    //ins_sec += 1     
        	 	STR val|ues_list[]
        	 	in_c.List_values(val[])    
        	 	----------------------- 'insert values of 1 section'
        	 	INT n|umber_of_section = 0
        	 	INT where_ins|ert = c_text[].Count
        	 	FOR lines IN c_text[] :
        	 	 	CASE lines.[0] != "[" ? CONTINUE lines ;
        	 	 	n += 1
        	 	 	CASE n <= del_index ? CONTINUE lines ;
        	 	 	where_ins = lines.INDEX
        	 	 	BREAK lines     
        	 	;
    	 	 	FOR v IN val[* DOWNTO 0] :
    	 	 	    CASE v=="LAST" ? CONTINUE v ;
                    //DEBUG: 
                    //      CASE v=="Activity" ? 
                    //           << "set for gal " igal " section " isec
                    //           " Activity=" in_c.Str(v) #TAB ;
                    //;
    	 	 	    c_text[].Insert(where_ins, v "=" in_c.Str(v)) 
    	 	 	;
    	 	 	c_text[].Insert(where_ins, "[+]")
        	----------------------------------------------------------->
            CASE Create_bak.Checked ? 
                 Delete_file(filename.Change_ext(".gal.bak"))
                 Copy_file(filename, filename.Change_ext(".gal.bak")) 
            ;
            --------------------- 'renumber sections'
            n = 0
            FOR lines IN c_text[] :
                //CASE lines.Starting("LAST=") ?
                //     c_text[lines.INDEX] = "LAST"
                //     "=" (n==last_c_sec-del_sec+ins_sec).S
                //;
                CASE lines.[0] != "[" ? CONTINUE lines ;
                n += 1     
                c_text[lines.INDEX] = "[" n.S "]"     
            ;
            FOR lines IN c_text[] :
                CASE lines.[0]=="[" ? BREAK lines ;
                CASE lines.Starting("Count_spirals=") { 
                     c_text[lines.INDEX] = "Count_spirals=" n.S
                     BREAK lines
                }
            ;
            INT cur|rent_section = 0
            FOR lines IN c_text[] :
                CASE lines.[0] == "[" ?
                     cur += 1 
                     DEBUG: "" lines " --> cur=" cur #NL ;
                     BOOL found_LAST|_in_last = FALSE
                ;
                CASE lines.Starting("LAST=") ? 
                     DEBUG: "in gal " igal " found LAST: " lines 
                     	", set to " (cur==n).S
                     	" because cur=" cur " and n=" n #NL ;
                     found_LAST = TRUE
                     c_text[lines.INDEX] = "LAST=" (cur==n).S ;
            ;
            CASE !found_LAST ? c_text[] << "LAST=TRUE" ;
        	c_text[].To_text_file(filename, 'UTF8')
        ;
    ["SAT_DEL"]:
        CASE Last_sel < 0 ? 
             message("There is no galaxy model selected.") ==> ;
        STR dname|_to_delete = Main_.Satellite_param.Edit_name.Text
        CASE dname == "" ? 
             message("Only named satellite can be deleted in "
             "collected galaxy models.") ==> ;
        CASE !ask("Delete satellite [" dname "] in all models?") ? ==> ;
		filename = List.Get_item(Last_sel, 0).After(#TAB)
		Main_.Satellite_param.Save_gal(filename, TRUE, TRUE)
        //CASE !ask("Delete satellite [" dname "] in all models? Yes?") ? ==> ;
        FOR igal IN [List.Count-1 DOWNTO 0] :
        	filename = List.Get_item(igal, 0).After(#TAB)
	    	c = New_write_in_file_config(filename, "")
	    	last_c_sec = last_section(c)
	    	FOR isec IN [0 TO last_c_sec] :
	    	    c.Section = (isec+1).S 
	    	    CASE c.Bool("LAST") {
	    	         last_c_sec = isec
	    	         BREAK isec
	    	    }
	    	;
	    	PUSH c.No_write = TRUE :
	    		 INT del_sec|tions_deleted_in_c = 0     
	        	 FOR isec IN [last_c_sec DOWNTO 0] :
	        	     c.Section = (isec+1).S 
	        	     c.Set_b("LAST", FALSE)
	        	 	 CASE c.Str("Name")==dname ? 
	        	 	      c.Delete_subkey(c.Section)
	        	 	      del_sec += 1
	        	 	      last_c_sec -= 1 ;
	        	 ;
		    	 CASE del_sec == 0 ? CONTINUE igal ;
		    	 --------------------- 'changes in common'     
		    	 c.Section = ""
		    	 c.Set_i("Count_spirals", last_c_sec+1)
		    	 c.List_subkeys(val[])
		    	 FOR i IN [0 TO val[].Count-1] : val[i] = (i+1).S ;
		    	 c.Rename_subkeys(val[0 TO *])
		    	 c.Section = val[last_c_sec]
		    	 c.Set_b("LAST", TRUE)
		    	 -------------------------- 'bak'
	             CASE Create_bak.Checked ? 
	                  Delete_file(filename.Change_ext(".gal.bak"))
	                  Copy_file(filename, filename.Change_ext(".gal.bak")) 
	             ;
	    	;
	    	c.Update
        ;
        ----------------- 'reload current gal'
        filename_in = List.Get_item(Last_sel, 0).After(#TAB)
        Main_.Satellite_param.Load_gal(filename_in, FALSE, TRUE)
        Main_.Invalidate
    ["REGULAR_ACTIVITY"]:
        STR aname|_to_interva_activity = Main_.Satellite_param.Edit_name.Text
        CASE aname == "" ? 
             message("Satellite should be named to change activity!") ==> ;
        n = 0
        REAL min_a|ctivity
        REAL max_a|ctivity
        FOR igal IN [0 TO List.Count-1] :
        	filename = List.Get_item(igal, 0).After(#TAB)
	    	c = New_read_in_file_config(filename, "")
	    	last_c_sec = last_section(c)
	    	FOR isec IN [0 TO last_c_sec] :
	    	    c.Section = (isec+1).S
	    	    CASE c.Str("Name") != aname ? CONTINUE isec ;
	    	    n += 1
	    	    REAL a|ctivity_value = c.Real("Activity")
	    	    CASE n==1 || a < min_a ? min_a = a ;
	    	    CASE n==1 || a > max_a ? max_a = a ;
	    	    BREAK isec     
	    	;
	    	NEXT igal += List.Count-1
    	;
        //CASE n <= 1 || min_a.Near(max_a) ? 
        //     message("Activity value should be different at least for "
        //     "2 galaxy models!") ==> ;
    	-------------------------------- 'save current gal model 1st'
    	filename = List.Get_item(Last_sel, 0).After(#TAB)
		Main_.Satellite_param.Save_gal(filename, TRUE, TRUE)
		-------------------------------- 'make activity regular between models'
    	a = min_a
    	REAL delta|_activity = (max_a - min_a) / (List.Count-2)
    	CASE !ask("Satellite [" aname "] activity min value " min_a.S 
    	     " and max value " max_a.S ", "
    		 "so delta=" delta.S "; Continue making regular activity for "
    		 "" aname "?") ? ==> ;
        FOR igal IN [0 TO List.Count-1] :
        	filename = List.Get_item(igal, 0).After(#TAB)
	    	c = New_write_in_file_config(filename, "")
	    	PUSH c.No_write = TRUE :
		    	 last_c_sec = last_section(c)
		    	 BOOL found_1|_satellite = FALSE
		    	 FOR isec IN [0 TO last_c_sec] :
		    	     c.Section = (isec+1).S
		    	     CASE c.Str("Name") != aname ? CONTINUE isec ;
		    	     DEBUG:
		    	           << "for gal=" igal " sat sec=" isec " set A=" a #NL
		    	     ;
		    	     c.Set_s("Activity", a.S_float(1))
		    	     CASE !found_1 ? a += delta ;
		    	     found_1 = TRUE     
		    	 ;
	    	;
	    	c.Update
    	;
    	Main_.Satellite_param.Load_gal(filename, FALSE, TRUE)
    	Main_.Invalidate
    ["SAME_CENTER"]:
        aname = Main_.Satellite_param.Edit_name.Text
        CASE aname == "" ? 
             message("Satellite should be named to change center point!") ==> ;
        {point} center|_point_to_use = Pt(Main_.Offset_x, .Offset_y)
        FOR igal IN [0 TO List.Count-1] :
            CASE igal==Last_sel ? CONTINUE igal ;
        	filename = List.Get_item(igal, 0).After(#TAB)
	    	c = New_write_in_file_config(filename, "")
	    	PUSH c.No_write = TRUE :
		    	 last_c_sec = last_section(c)
		    	 FOR isec IN [0 TO last_c_sec] :
		    	     c.Section = (isec+1).S
		    	     CASE c.Str("Name") != aname ? CONTINUE isec ;
		    	     DEBUG:
		    	           << "for gal=" igal " sat sec=" isec #NL
		    	     ;
		    	     c.Set_s("CenterX", center.X.S)
		    	     c.Set_s("CenterY", center.Y.S)
		    	 ;
	    	;
	    	c.Update
    	;
    ; .
    
FUN last_section|_index({In_file_config} c|onfiguration) ==> INT :
	STR subk|eys_list[]
	c.List_subkeys(subk[])
    FOR i IN [1 TO subk[].Count] :
        CASE c.Bool("LAST") ? RESULT = i ==> ;
    ;
    RESULT = subk[].Count-1 .
    

OVERRIDE timer :
    CASE sender_alias ?
    ["TIMER_FIX"]:
        Timer_fix.Set_active(FALSE)
        CASE Main_.Satellite_param.Satellite_num.Current < 0 ? 
        DEBUG: "Current sat=" Main_.Satellite_param.Satellite_num.Current 
        #NL ;
             Main_.Satellite_param.Satellite_num.Select(0) 
        DEBUG: "new Current=" Main_.Satellite_param.Satellite_num.Current 
        #NL ;
        ;
	ELSE BASE        
    ; .
    
{Bitmap} source_|overlay_
INT w_source|_width
{Bitmap_direct} ready_over|lays[]
    
METHOD Prepare_overlay(
{Bitmap} Source|_scaled_bitmap,
{rect} Dest|ination_rect) ==> {Bitmap}
    :
	ready_over[].Allocate(2)
	CASE source_ != Source || w_source != Dest.Width.Int ? 
	     ready_over[0] = NONE 
	     ready_over[1] = NONE ;
	source_ = Source
	w_source = Dest.Width.Int
	CASE !Overlay_inverted.Checked ? INT ind|ex_in_ready = 0 ELSE ind = 1 ;
	CASE ready_over[ind] != NONE ? RESULT = ready_over[ind] ==> ;
	----------------------------- 'make ready_over[ind]'
	BYTE alpha|_tran = '80'         
	BOOL inverted = ind > 0
    DEBUG: "__________prepare overlay invert=" inverted.S " Dest=" Dest.S #NL ; 
    {Bitmap_direct} temp|_bitmap = New_bitmap_direct(
    	Main_.PBox.Width.Points_to_pixels,
    	Main_.PBox.Height.Points_to_pixels, 32)
    
   	Source.Stretch_draw(temp.Canvas, Dest)
   		
   	FOR y IN [0 TO temp.Height-1] :
   	    temp.Lock_rows(y, 1, TRUE) 
   	    INT xb|yte_position_in_pixels_row = 0
   	    FOR x IN [0 TO temp.Width - 1] :
   	    	CASE ind>0 ? 
   	    	     temp.Pixels[xb] = (255 - _.Int).Byte 
   	    	     temp.Pixels[xb+1] = (255 - _.Int).Byte 
   	    	     temp.Pixels[xb+2] = (255 - _.Int).Byte 
   	    	;
   	        temp.Pixels[xb+3] = alpha
   	        xb += 4
   	    ;
   		temp.Unlock(TRUE)    
   	;
   	ready_over[ind] = temp
   	RESULT = temp .
	
    

OVERRIDE value_change :
    CASE sender_alias ?
    ["ONLY_OVERLAY", "DRAW_SPIRAL_1", "DRAW_OVER"]: Main_.PBox.Invalidate_all 
    ["OVERLAY_INVERTED"]: Main_.PBox.Invalidate_all
	    Main_.PBox.Invalidate_all
    ; .
    
BOOL list_changed
    
METHOD Changed_list :
    list_changed = TRUE 
    Save_col.Set_ink(RED)
    .
    
METHOD Next_line :
    CASE Last_sel < List.Count-1 ? 
         List.Select(Last_sel+1, TRUE) ; .
         
METHOD Prev_line :
    CASE Last_sel > 0 ? 
         List.Select(Last_sel-1, TRUE) ; .
    

OVERRIDE key_down ==> {Form}.{action} :
	CASE Key.Special ? 
	[PAGE_UP]: Prev_line 
		RESULT = 'DECLINE'
	[PAGE_DOWN]: Next_line 
		RESULT = 'DECLINE'
	ELSE NONE ; .
	
END

*/
